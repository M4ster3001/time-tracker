{
  "name": "time-tracker-system",
  "version": "1.0.0",
  "description": "Open-source time tracking and client/project management for service teams.",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "prepare": "husky install",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "playwright test --config=frontend/playwright.config.ts --workers=2",
    "wait:backend": "node scripts/wait-backend-health.mjs",
    "legal:inventory": "node scripts/third-party-notices.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "lint:ci": "eslint backend/src frontend/src --ext .ts,.tsx --quiet --rule \"prettier/prettier:off\"",
    "release:check": "node scripts/check-release-safety.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^8.0.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.3.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "license": "MIT",
  "packageManager": "npm@11.9.0",
  "overrides": {
    "vite": "$vite",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "uuid": "^11.1.1"
  }
}
