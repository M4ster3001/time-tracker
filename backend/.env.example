# Environment
NODE_ENV=development
TZ=America/Sao_Paulo

# Server
PORT=5000
# Para Docker Compose, o arquivo backend/.env.docker substitui o endereço de bind.
HOST=127.0.0.1

# Database
DATABASE_URL=mysql://time_tracker_user:replace-with-app-password@127.0.0.1:3306/time_tracker
# Shadow database for Prisma migrations
SHADOW_DATABASE_URL=mysql://time_tracker_user:replace-with-app-password@127.0.0.1:3306/time_tracker_shadow

# Time entry lock day (1-28). Leave empty to disable locking.
TIME_ENTRY_LOCK_DAY=
DAILY_SEED_ENABLED=false
DAILY_SEED_MAX_ENTRIES=120
ALLOW_DEMO_SEED=false
CONFIRM_DEMO_SEED_DELETE=

# JWT (REQUIRED - must be at least 32 characters)
JWT_SECRET=
JWT_EXPIRATION=15m

# Field-level encryption key (64 hex chars = 32 bytes for AES-256)
# Required in staging/production. Development/test may omit and derive from JWT_SECRET.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# Refresh token
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE=refresh_token

# Demo seed (local development only; use a unique value of at least 16 characters)
DEMO_SEED_PASSWORD=

# Bcrypt
BCRYPT_ROUNDS=10

# CORS / CSRF Origin allowlist (comma-separated). Same list gates browser Origin/Referer.
CORS_ORIGIN=http://localhost:3000
# LAN via IP (ex.: http://192.168.x.x:3000): liste a origem explícita OU, só em
# non-production, ative o padrão RFC1918/loopback (ignorado se NODE_ENV=production):
# CORS_ORIGIN=http://localhost:3000,http://192.168.31.119:3000
# CORS_ALLOW_PRIVATE_LAN=true
CORS_ALLOW_PRIVATE_LAN=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Logging
LOG_LEVEL=info
# Opt-in Prisma SQL+params logging (PII risk). Only honored when NODE_ENV=development.
# PRISMA_LOG_QUERIES=true

# Redis Cache (optional - falls back to in-memory if disabled)
# Enable only after configuring a Redis service for this environment.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_DASHBOARD=300
REDIS_CACHE_TTL_LOCK_STATUS=60

# Google Calendar Integration (optional)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-calendar/callback

# MCP OAuth protected-resource discovery (optional scaffolding only)
# Filling these configures GET /.well-known/oauth-protected-resource metadata.
# Time Tracker does NOT issue OAuth tokens; MCP tools still use JWT/PAT (or stdio USER_ID).
# See docs/integrations/mcp.md — not production OAuth until a live IdP + token validation exist.
# MCP_OAUTH_RESOURCE_URI=https://time-tracker.example/api/mcp
# MCP_OAUTH_AUTHORIZATION_SERVERS=https://identity.example.com
# MCP_OAUTH_SCOPES=mcp.use,estimates.read
# MCP_OAUTH_DOCUMENTATION_URL=https://docs.example/mcp-oauth

# Data Retention Policy (days)
AUDIT_LOG_RETENTION_DAYS=90
EXPIRED_TOKEN_RETENTION_DAYS=30
REVOKED_TOKEN_RETENTION_DAYS=30

# AI Suggestions (optional feature)
# Enable/disable AI-powered activity suggestions
AI_SUGGESTIONS_ENABLED=false
AI_PROVIDER=openai  # Options: openai | gemini | anthropic
AI_MAX_SUGGESTIONS=5
AI_MAX_CONTEXT_ENTRIES=20
AI_CACHE_TTL_SECONDS=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=10

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (when AI_PROVIDER=gemini)
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude Configuration (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Database Backup Configuration
# Enable/disable automatic backups
BACKUP_ENABLED=false
# Cron schedule for backups (default: midnight daily)
BACKUP_SCHEDULE=0 0 * * *
# Number of days to retain backups
BACKUP_RETENTION_DAYS=30
# Backup providers (comma-separated): local, aws, azure, gcp
# Example: "local" or "local,aws" for both local and cloud
BACKUP_PROVIDERS=local

# Local backup storage path
# Docker Compose overrides this to /app/backups, matching its persistent volume.
# To change the host directory, set BACKUP_HOST_PATH in the root .env instead.
BACKUP_LOCAL_PATH=./backups

# AWS S3 Configuration (when using aws provider)
AWS_BACKUP_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Blob Storage Configuration (when using azure provider)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BACKUP_CONTAINER=backups

# Google Cloud Storage Configuration (when using gcp provider)
GCP_PROJECT_ID=
GCP_BACKUP_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
