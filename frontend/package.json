{
  "name": "@time-tracker/frontend",
  "version": "1.0.0",
  "description": "Frontend da aplicação Time Tracker System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --config=./playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx --rule \"prettier/prettier:off\"",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "license": "MIT"
}
