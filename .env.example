# Docker Compose — desenvolvimento local. Preencha antes de iniciar.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=time_tracker_user
MYSQL_PASSWORD=
FRONTEND_PORT=3000
# Backups ficam em um volume Docker por padrão (funciona em qualquer SO).
# Para gravar em outro disco/pasta do host, descomente e informe um caminho que
# JÁ EXISTA e permita escrita. Exemplos:
#   Windows: BACKUP_HOST_PATH=F:/time-tracker-backups
#   Linux:   BACKUP_HOST_PATH=/mnt/backup/time-tracker
#   macOS:   BACKUP_HOST_PATH=/Volumes/Backup/time-tracker
# BACKUP_HOST_PATH=
# Deixe vazio para iniciar sem o perfil Redis.
COMPOSE_PROFILES=
